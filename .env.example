# Application JWT (for signing the booking-link tokens)
# Generate a long random string, at least 32 characters
JWT_SECRET=replace-with-random-string-min-32-chars

# Salesforce External Client App credentials
SF_CLIENT_ID=your_consumer_key_from_external_client_app
SF_USERNAME=your-email@domain.com.SANDBOXNAME
SF_LOGIN_URL=https://test.salesforce.com

# Salesforce private key (RSA, multi-line including BEGIN/END lines)
# In Railway UI, paste with real newlines. Locally, you can set it from a file.
SF_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----
MIIEowIBAAKCAQEA...
...
-----END RSA PRIVATE KEY-----

# Shared secret between Make and this API
# Generate another long random string
MAKE_API_KEY=replace-with-another-random-string

# Bolt frontend base URL (no trailing slash)
APP_BASE_URL=https://your-bolt-app.bolt.host
